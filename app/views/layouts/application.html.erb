<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : "Save editor for .rxdata files" %></title>
    <%= csrf_meta_tags %>
    <style>
      :root {
        --ground: #e6e9ef;
        --panel: #ffffff;
        --ink: #161e2b;
        --muted: #5b6879;
        --rule: #d3d9e2;
        --rule-strong: #b9c2ce;
        --action: #4a32a8;
        --action-hover: #3a2686;
        --changed-ink: #8a5300;
        --changed-bg: #fff3d9;
        --changed-edge: #d99b1f;
        --danger: #9e2117;
        --danger-bg: #fbeae8;
        --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--ground);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 15px;
        line-height: 1.5;
        font-variant-numeric: tabular-nums;
      }

      .shell { max-width: 1080px; margin: 0 auto; padding: 24px 20px 120px; }

      a { color: var(--action); }
      a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible {
        outline: 2px solid var(--action);
        outline-offset: 2px;
      }

      .masthead { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
      .masthead h1 { font-size: 19px; font-weight: 620; letter-spacing: -0.01em; margin: 0; }
      .masthead h1 a { color: inherit; text-decoration: none; }
      .masthead p { margin: 0; color: var(--muted); font-size: 13.5px; }

      /* The parsed-file readout is the one place the interface shows off: it is
         the proof that the file was understood before anything is changed. */
      .readout {
        font-family: var(--mono);
        font-size: 13px;
        background: var(--ink);
        color: #dfe5ee;
        border-radius: 3px;
        padding: 12px 14px;
        margin-bottom: 18px;
        overflow-x: auto;
        white-space: nowrap;
      }
      .readout b { color: #ffffff; font-weight: 600; }
      .readout .sep { color: #6b7a90; padding: 0 10px; }

      .panel {
        background: var(--panel);
        border: 1px solid var(--rule);
        border-radius: 3px;
        margin-bottom: 18px;
      }
      .panel > h2 {
        font-size: 14px;
        font-weight: 620;
        margin: 0;
        padding: 12px 16px;
        border-bottom: 1px solid var(--rule);
      }
      .panel-body { padding: 16px; }
      .panel-note { padding: 0 16px 14px; color: var(--muted); font-size: 13px; margin: 0; }

      table { width: 100%; border-collapse: collapse; }
      th { text-align: left; font-size: 12px; font-weight: 600; color: var(--muted); padding: 8px 16px; border-bottom: 1px solid var(--rule); }
      td { padding: 7px 16px; border-bottom: 1px solid var(--rule); vertical-align: middle; }
      tr:last-child td { border-bottom: none; }
      .row.changed td { background: var(--changed-bg); }
      .row.changed td:first-child { box-shadow: inset 3px 0 0 var(--changed-edge); }

      .name { font-weight: 520; }
      .name a { text-decoration: none; }
      .name a:hover { text-decoration: underline; }
      .type { color: var(--muted); font-size: 13px; white-space: nowrap; }
      .value-mono { font-family: var(--mono); font-size: 13px; color: var(--muted); word-break: break-word; }
      .offset { font-family: var(--mono); font-size: 12px; color: var(--muted); white-space: nowrap; }
      .was { display: block; font-family: var(--mono); font-size: 12px; color: var(--changed-ink); }

      input[type="text"], input[type="search"], select {
        font-family: var(--mono);
        font-size: 13px;
        padding: 5px 8px;
        border: 1px solid var(--rule-strong);
        border-radius: 2px;
        background: #fff;
        color: var(--ink);
        width: 100%;
        max-width: 320px;
      }
      input[type="file"] { font-family: var(--sans); font-size: 14px; }

      .btn {
        font-family: var(--sans);
        font-size: 14px;
        font-weight: 550;
        padding: 8px 16px;
        border-radius: 2px;
        border: 1px solid transparent;
        background: var(--action);
        color: #fff;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
      }
      .btn:hover { background: var(--action-hover); }
      .btn.quiet { background: #fff; color: var(--ink); border-color: var(--rule-strong); }
      .btn.quiet:hover { background: #f4f6fa; }
      .btn.link { background: none; border: none; color: var(--action); padding: 0; font-size: 13px; }
      .btn.link:hover { background: none; text-decoration: underline; }

      .tabs { display: flex; gap: 2px; flex-wrap: wrap; margin-bottom: 18px; border-bottom: 1px solid var(--rule-strong); }
      .tab {
        padding: 8px 14px;
        font-size: 14px;
        color: var(--muted);
        text-decoration: none;
        border: 1px solid transparent;
        border-bottom: none;
        border-radius: 3px 3px 0 0;
        margin-bottom: -1px;
      }
      .tab:hover { color: var(--ink); background: #edf0f5; }
      .tab.active {
        background: var(--panel);
        color: var(--ink);
        font-weight: 560;
        border-color: var(--rule-strong);
        border-bottom: 1px solid var(--panel);
      }
      .pill {
        display: inline-block;
        min-width: 18px;
        padding: 0 5px;
        margin-left: 4px;
        background: var(--changed-bg);
        color: var(--changed-ink);
        border: 1px solid var(--changed-edge);
        border-radius: 9px;
        font-size: 11px;
        font-weight: 600;
        text-align: center;
      }

      .path { display: block; font-size: 12px; color: var(--muted); font-weight: 400; }
      .path a { color: var(--muted); text-decoration: none; }
      .path a:hover { color: var(--action); text-decoration: underline; }

      .offset-hex { display: block; }
      .was-inline { text-decoration: line-through; }
      .arrow { padding: 0 6px; color: var(--muted); }
      tr.muted td { opacity: 0.55; }

      .crumbs { font-size: 13px; color: var(--muted); margin-bottom: 14px; word-break: break-word; }
      .crumbs a { text-decoration: none; }
      .crumbs span { padding: 0 6px; color: var(--rule-strong); }

      .toolbar { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 18px; }
      .toolbar form.search { display: flex; gap: 8px; flex: 1 1 300px; }
      .toolbar form { margin: 0; }

      .flash { padding: 10px 14px; border-radius: 3px; margin-bottom: 16px; font-size: 14px; }
      .flash.notice { background: #e7f0e8; border: 1px solid #b9d3bd; }
      .flash.alert { background: var(--danger-bg); border: 1px solid #e3b5b0; color: var(--danger); }

      .actionbar {
        position: sticky;
        bottom: 0;
        margin: 0 -20px -120px;
        padding: 14px 20px;
        background: rgba(255, 255, 255, 0.96);
        border-top: 1px solid var(--rule-strong);
        display: flex;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
      }
      .actionbar .count { font-size: 13.5px; color: var(--muted); flex: 1 1 auto; }
      .actionbar .count b { color: var(--changed-ink); }

      .lede { max-width: 62ch; }
      .lede p { color: var(--muted); }
      .steps { max-width: 62ch; color: var(--muted); font-size: 14px; padding-left: 18px; }
      .steps li { margin-bottom: 6px; }

      @media (max-width: 640px) {
        th:nth-child(2), td:nth-child(2), th:last-child, td:last-child { display: none; }
        .shell { padding: 16px 14px 130px; }
        .actionbar { margin: 0 -14px -130px; }
      }

      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <div class="masthead">
        <h1><%= link_to "Save editor", root_path %></h1>
        <p>Edit values inside RPG Maker XP <code>.rxdata</code> saves</p>
      </div>

      <% if flash[:notice] %><div class="flash notice"><%= flash[:notice] %></div><% end %>
      <% if flash[:alert] %><div class="flash alert"><%= flash[:alert] %></div><% end %>

      <%= yield %>
    </div>

    <script>
      // Edits save themselves. Leaving a field commits it; clicking away to
      // another tab commits it first and then follows the link, so there is
      // nothing to remember to press.
      (function () {
        var form = document.querySelector("form[data-autosave]");
        if (!form) return;
        var onward = form.querySelector('input[name="next"]');
        if (!onward) return;
        var timer = null;

        function saveThenGo(url) {
          if (timer) { clearTimeout(timer); timer = null; }
          onward.value = url || "";
          if (typeof form.requestSubmit === "function") { form.requestSubmit(); } else { form.submit(); }
        }

        // A field commits when you leave it. The short delay lets a click that
        // caused the blur -- on a tab, say -- redirect the save to that page
        // instead, so the click is not swallowed by the reload.
        form.addEventListener("change", function () {
          if (timer) clearTimeout(timer);
          timer = setTimeout(function () { saveThenGo(""); }, 200);
        });

        document.addEventListener("click", function (event) {
          if (event.defaultPrevented || event.metaKey || event.ctrlKey ||
              event.shiftKey || event.altKey || event.button !== 0) return;
          var link = event.target.closest && event.target.closest("a[href]");
          if (!link || link.target === "_blank" || link.hasAttribute("download")) return;
          var url = new URL(link.getAttribute("href"), location.href);
          if (url.origin !== location.origin) return;
          if (!timer) return;
          event.preventDefault();
          saveThenGo(url.pathname + url.search);
        }, true);

        // The search box is its own form; run any pending edit through first
        // and let the search happen on the far side of it.
        document.addEventListener("submit", function (event) {
          if (!timer || event.target === form) return;
          var other = event.target;
          if ((other.getAttribute("method") || "get").toLowerCase() !== "get") return;
          event.preventDefault();
          var query = new URLSearchParams(new FormData(other));
          query.delete("utf8");
          query.delete("authenticity_token");
          var action = new URL(other.getAttribute("action") || location.href, location.href);
          var suffix = query.toString();
          saveThenGo(action.pathname + (suffix ? "?" + suffix : ""));
        }, true);
      })();

      // Saving reloads the page, so remember where the reader was and which
      // field they had moved on to.
      (function () {
        var key = "rxdata:place:" + location.pathname + location.search;
        document.addEventListener("submit", function () {
          try {
            var active = document.activeElement;
            sessionStorage.setItem(key, JSON.stringify({
              y: window.scrollY,
              focus: active && active.name ? active.name : null
            }));
          } catch (e) {}
        }, true);
        window.addEventListener("pageshow", function () {
          try {
            var saved = sessionStorage.getItem(key);
            if (!saved) return;
            sessionStorage.removeItem(key);
            var place = JSON.parse(saved);
            window.scrollTo(0, place.y);
            if (!place.focus) return;
            var field = document.querySelector('[name="' + place.focus + '"]');
            if (!field) return;
            field.focus();
            if (field.setSelectionRange && field.type === "text") {
              field.setSelectionRange(field.value.length, field.value.length);
            }
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
