<nav class="tabs" aria-label="Sections of this save">
  <% @tabs.each do |tab| %>
    <% active = (tab[:id] == @tab) %>
    <%= link_to save_path(@id, tab: tab[:id]),
                class: "tab#{' active' if active}",
                "aria-current": (active ? "page" : nil) do %>
      <%= tab[:title] %><% if tab[:count].to_i.positive? %> <span class="pill"><%= tab[:count] %></span><% end %>
    <% end %>
  <% end %>
</nav>
